COURSE_AGENT_APP_NAME=Course Learning Assistant API
COURSE_AGENT_ENVIRONMENT=development
COURSE_AGENT_DEBUG=true
COURSE_AGENT_API_PREFIX=/api/v1
COURSE_AGENT_SECRET_KEY=change-me-in-local-env
COURSE_AGENT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
COURSE_AGENT_PASSWORD_MIN_LENGTH=8

COURSE_AGENT_DATABASE_URL=postgresql+asyncpg://course_agent:course_agent@localhost:5432/course_agent
COURSE_AGENT_REDIS_URL=redis://localhost:6379/0

COURSE_AGENT_S3_ENDPOINT=localhost:9000
COURSE_AGENT_S3_ACCESS_KEY=minioadmin
COURSE_AGENT_S3_SECRET_KEY=minioadmin
COURSE_AGENT_S3_BUCKET=course-materials
COURSE_AGENT_S3_SECURE=false

COURSE_AGENT_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COURSE_AGENT_LOG_LEVEL=INFO
